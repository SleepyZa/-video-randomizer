name: Build Windows exe

# Builds dist/VideoRandomizer.exe on a Windows runner and uploads it as a
# downloadable artifact. Use this if you don't want to install anything on
# your own PC: push this repo to GitHub, run this workflow (Actions tab ->
# "Build Windows exe" -> "Run workflow"), then download the artifact from
# the finished run.

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install Python dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pyinstaller opencv-python-headless numpy tkinterdnd2

      - name: Download ffmpeg (essentials build)
        shell: pwsh
        run: |
          Invoke-WebRequest -Uri "https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip" -OutFile ffmpeg.zip
          Expand-Archive ffmpeg.zip -DestinationPath ffmpeg_extracted
          New-Item -ItemType Directory -Force -Path ffmpeg | Out-Null
          $bin = Get-ChildItem -Path ffmpeg_extracted -Recurse -Filter ffmpeg.exe | Select-Object -First 1
          Copy-Item $bin.FullName ffmpeg\ffmpeg.exe
          $bin2 = Get-ChildItem -Path ffmpeg_extracted -Recurse -Filter ffprobe.exe | Select-Object -First 1
          Copy-Item $bin2.FullName ffmpeg\ffprobe.exe

      - name: Build with PyInstaller
        run: >
          python -m PyInstaller
          --name VideoRandomizer
          --onefile
          --windowed
          --add-binary "ffmpeg\ffmpeg.exe;ffmpeg"
          --add-binary "ffmpeg\ffprobe.exe;ffmpeg"
          --collect-all tkinterdnd2
          --collect-all cv2
          --clean
          video_randomizer_gui.py

      - uses: actions/upload-artifact@v4
        with:
          name: VideoRandomizer-windows
          path: dist/VideoRandomizer.exe
